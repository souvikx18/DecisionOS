# ============================================================
# DecisionOS — Docker Production Environment Configuration
# Copy this file to .env before running: docker compose up -d
# ============================================================

# ── General Server Settings ──
NODE_ENV=production
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1

# ── Database (PostgreSQL) ──
POSTGRES_USER=decisionos
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=decisionos
DATABASE_URL=postgresql://decisionos:your_secure_postgres_password_here@postgres:5432/decisionos?schema=public

# Optional: To use cloud Supabase / Neon / AWS RDS instead:
# DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# ── Redis Cache & BullMQ Queue ──
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:your_secure_redis_password_here@redis:6379

# ── Auth / Cookie Sessions ──
COOKIE_SECRET=your_64_character_hex_cookie_secret_here
SESSION_TTL_SECONDS=604800

# ── Supabase Cloud Storage (Reports & Ingestion files) ──
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
STORAGE_BUCKET=decisionos-files

# ── AI Reasoning Engine (Google Gemini) ──
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# ── Transactional Email (Resend) ──
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev

# ── Razorpay Billing (UPI, Cards, NetBanking) ──
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here


# ── Super Admin & Seeding ──
SUPER_ADMIN_EMAIL=admin@decisionos.com
SEED_DATABASE=false
