# Backend Environment Variables Template
# Copy this file to .env and provide your own credentials

# Server
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/decisionos

# Redis
REDIS_URL=redis://localhost:6379

# Auth / Sessions
COOKIE_SECRET=your_cookie_secret_at_least_32_characters_long
SESSION_TTL_SECONDS=604800

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
STORAGE_BUCKET=decisionos-uploads

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=notifications@yourdomain.com

# AI Provider (google | openai)
AI_PROVIDER=google
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Razorpay Billing
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Super Admin
SUPER_ADMIN_EMAIL=admin@decisionos.com
