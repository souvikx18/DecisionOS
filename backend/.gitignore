# ============================================================
# DecisionOS Backend — .gitignore
# ============================================================

# Environment secrets — NEVER commit these
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example

# Dependencies
node_modules/
node_modules/.prisma/

# Local Uploads & ZK auth storage
uploads/*
!uploads/.gitkeep
data/zk_store.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS & Editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Build output & binaries
dist/
build/
*.exe
stripe.exe
