# ============================================================
# DecisionOS Frontend — .gitignore
# ============================================================

# Environment variables & secrets — NEVER commit these
.env
.env.*
*.env
*.env.*
*.local
!.env.example
!*.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules/

# Production build output
dist/
dist-ssr/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
